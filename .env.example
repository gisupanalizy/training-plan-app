# Bez konfiguracji działa tylko prototyp demonstracyjny.
# Dla lokalnego Supabase: APP_ENV=local, adres i klucz z `npx supabase status`.
# Nigdy nie zapisuj wartości sekretów w repozytorium.
APP_ENV=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Dla lokalnego CLI z kluczem anon: NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Dla preview/production obie wartości wymagane; ref preview musi się różnić od produkcyjnego.
SUPABASE_EXPECTED_PROJECT_REF=
SUPABASE_PRODUCTION_PROJECT_REF=
# T06: wyłącznie na serwerze. Prawdziwe wywołania wymagają klucza i uzgodnionego budżetu.
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
OPENAI_IMPORT_ENABLED=
OPENAI_IMPORT_BUDGET_USD=
# T09: osobny dzienny budżet i jawne włączenie głosu; bez nich formularze ręczne pozostają dostępne.
OPENAI_VOICE_ENABLED=
OPENAI_VOICE_BUDGET_USD=
# Vercel Cron ustawia Authorization: Bearer CRON_SECRET przy sprzątaniu.
CRON_SECRET=
