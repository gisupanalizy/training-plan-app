# Nazwy bez wartości; nigdy nie zapisuj sekretów w repozytorium.
# Vercel Marketplace (Custom Prefix STORAGE): integracja ustawia automatycznie:
NEXT_PUBLIC_STORAGE_SUPABASE_URL=
NEXT_PUBLIC_STORAGE_SUPABASE_PUBLISHABLE_KEY=
# Starszy publiczny klucz integracji: NEXT_PUBLIC_STORAGE_SUPABASE_ANON_KEY=
STORAGE_SUPABASE_SECRET_KEY=
# Starszy klucz serwerowy integracji: STORAGE_SUPABASE_SERVICE_ROLE_KEY=
# Nie kopiuj ręcznie tych samych kluczy do drugiej rodziny nazw.

# Lokalny Supabase / instalacja bez integracji: alternatywna pełna rodzina.
# Jeśli integracja STORAGE jest obecna, poniższe duplikaty są pomijane.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Starszy publiczny klucz lokalnego CLI: NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Ręczne ustawienia aplikacji. Production/Preview mają osobne zakresy.
APP_ENV=
SUPABASE_EXPECTED_PROJECT_REF=
SUPABASE_PRODUCTION_PROJECT_REF=
CRON_SECRET=
# AI pozostaje wyłączone bez osobnej zgody, klucza i dodatnich budżetów.
OPENAI_API_KEY=
OPENAI_IMPORT_ENABLED=
OPENAI_IMPORT_BUDGET_USD=
OPENAI_VOICE_ENABLED=
OPENAI_VOICE_BUDGET_USD=
